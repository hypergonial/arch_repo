pkgname=vencord-install-hook
# Version/rel is updated by CI, do not edit manually
pkgver=1.0.1
pkgrel=1
pkgdesc='Pacman hook for installing Vencord when installing/updating Discord'
arch=('x86_64')
url="https://github.com/hypergonial/arch_repo/tree/main/vencord-install-hook"
license=('MIT')
depends=("pacman")
makedepends=(git)
source=("install-vencord.hook"
        "install-vencord-ptb.hook"
        "install-vencord-canary.hook")
sha256sums=('c9b150bcae7c2e0a1f882c93aa3a8e419230605abac368223384a0290c8cd522'
            '8b4f5bfdb8561bdf46d5a0068b3dd5d47991a14ce91e1f9a2e150c2ada397f25'
            '0146b7b13bceea76ca8a5ba804959c7bbd0b5afaf27e6c288ba21f6b83e59c79')

package() {
	install -Dm644 "${srcdir}/install-vencord.hook" "${pkgdir}/usr/share/libalpm/hooks/install-vencord.hook"
    install -Dm644 "${srcdir}/install-vencord-ptb.hook" "${pkgdir}/usr/share/libalpm/hooks/install-vencord-ptb.hook"
    install -Dm644 "${srcdir}/install-vencord-canary.hook" "${pkgdir}/usr/share/libalpm/hooks/install-vencord-canary.hook"
}
